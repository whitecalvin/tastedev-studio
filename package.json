{
  "name": "tastedev-studio",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-monaco.mjs && next dev",
    "build": "node scripts/prepare-monaco.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "desktop:dev": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "desktop:build": "node node_modules/@tauri-apps/cli/tauri.js build",
    "build:desktop": "node scripts/prepare-monaco.mjs && node scripts/build-desktop.mjs",
    "core:storage": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/core-storage.ts",
    "core:start": "node --env-file-if-exists=.env.local --experimental-strip-types transport/main.ts",
    "ai:login": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/ai-login.ts",
    "release:product:check": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Invoke-ProductRelease.ps1 -Config release.pipeline.json -Plan",
    "release:product:draft": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Invoke-ProductRelease.ps1 -Config release.pipeline.json",
    "release:product:publish": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Invoke-ProductRelease.ps1 -Config release.pipeline.json -Publish",
    "release:product:resume": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Invoke-ProductRelease.ps1 -Config release.pipeline.json -Publish -Resume",
    "release:product:force": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Invoke-ProductRelease.ps1 -Config release.pipeline.json -Publish -Force",
    "website:publish": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Publish-ProductWebsitePromotion.ps1 -Config release.product.json",
    "website:publish:check": "pwsh.exe -NoProfile -NoLogo -File ../tools/cross-platform-release/Publish-ProductWebsitePromotion.ps1 -Config release.product.json -Plan"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tauri-apps/api": "2.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "cron-parser": "^5.10.1",
    "js-yaml": "4.3.2",
    "lucide-react": "1.48.0",
    "monaco-editor": "0.57.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
